{
  "name": "ai-travel-planner",
  "version": "1.0.0",
  "description": "AI-powered travel planning application",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm start",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && pip install -r requirements.txt",
    "verify": "cd frontend && npm run build && cd ../backend && python test_structure.py",
    "setup:backend": "python setup.py"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}