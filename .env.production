# AI Trip Planner - Production Environment Template
# Copy this file to .env and fill in your actual production values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# External API Keys
SERP_API_KEY=your_serp_api_key
GEMINI_API_KEY=your_gemini_api_key

# JWT Configuration (CRITICAL: Use a secure key in production!)
SECRET_KEY=your_secure_jwt_secret_key_minimum_32_characters_long

# Production Settings
ENVIRONMENT=production
DEBUG=false

# Optional: CORS Configuration
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Optional: Database Configuration
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Optional: Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Optional: Logging
LOG_LEVEL=INFO
LOG_FORMAT=json